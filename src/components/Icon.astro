---
interface Props {
  name: 'external' | 'arrow-right' | 'arrow-down' | 'code' | 'play';
}
const { name } = Astro.props;
---

<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="icon">
  {name === 'external' && <path d="M5.5 3.5h7v7M12.5 3.5l-9 9" />}
  {name === 'arrow-right' && <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />}
  {name === 'arrow-down' && <path d="M8 2.5v11M3.5 9 8 13.5 12.5 9" />}
  {name === 'code' && <path d="M5.5 4 1.5 8l4 4M10.5 4l4 4-4 4" />}
  {name === 'play' && <path d="M4.5 3v10l8.5-5z" fill="currentColor" stroke="none" />}
</svg>

<style>
  .icon {
    width: 1em;
    height: 1em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
