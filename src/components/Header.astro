---
import { OWNER } from '../data/projects';

const path = Astro.url.pathname;
const onHome = path === '/';
const home = (hash: string) => (onHome ? hash : `/${hash}`);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="Mustafa Obaid — home">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28">
          <circle
            cx="16"
            cy="16"
            r="14.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          ></circle>
          <path
            d="M7 21.5 L11.5 10.5 L16 18 L20.5 10.5 L25 21.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
            stroke-linecap="round"
          ></path>
        </svg>
      </span>
      <span class="name">Mustafa Obaid</span>
    </a>
    <nav aria-label="Main">
      <ul>
        <li>
          <a href={home('#work')}>Work</a>
        </li>
        <li>
          <a href={home('#earlier')}>Earlier</a>
        </li>
        <li>
          <a href={home('#about')}>About</a>
        </li>
        <li>
          <a href={`https://github.com/${OWNER}`} rel="me">
            GitHub<span class="visually-hidden"> profile</span>
            <svg viewBox="0 0 16 16" aria-hidden="true" class="ext">
              <path
                d="M5 3h8v8M13 3 3 13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 70%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    text-decoration: none;
    font-weight: 650;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
  }

  .mark {
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  nav ul {
    display: flex;
    gap: clamp(0.25rem, 1.5vw, 1.25rem);
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 44px;
    padding-inline: 0.4rem;
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
  }

  nav a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .ext {
    width: 0.7em;
    height: 0.7em;
  }

  @media (max-width: 520px) {
    .name {
      display: none;
    }
  }
</style>
